# Firebase Web App Configuration (Required for Cloud Fallback & App Check)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (Optional reCAPTCHA Enterprise Site Key for Production, or Debug Token for Local/Demo)
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true

# Optional Google Maps JS API Key for Store & Courier Map views
VITE_GOOGLE_MAPS_API_KEY=
